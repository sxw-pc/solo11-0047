# Time: 2026-01-10T11:06:00Z
# User@Host: svc_app[svc_app] @ node-b [synthetic]  Id: 206
# Schema: shopdemo
# Query_time: 2.050000  Lock_time: 0.800000 Rows_sent: 80  Rows_examined: 130000
SET timestamp=1768039200;
SELECT c.id, c.name, COUNT(o.id) AS order_count
FROM customers c
JOIN orders o ON o.customer_id = c.id
WHERE lower(c.region) = 'east'
GROUP BY c.id, c.name
ORDER BY order_count DESC
LIMIT 100;

