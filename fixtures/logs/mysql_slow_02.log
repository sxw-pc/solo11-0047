SET timestamp=1768039200;
SELECT oi.order_id, SUM(oi.quantity) AS qty
FROM order_items oi
JOIN orders o ON o.id = oi.order_id
WHERE o.created_at >= '2026-01-02'
GROUP BY oi.order_id
ORDER BY qty DESC
LIMIT 50;

