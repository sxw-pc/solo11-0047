      },
      "indexes": [
        {
          "name": "PRIMARY",
          "columns": [
            "id"
          ]
        },
        {
          "name": "idx_customers_region",
          "columns": [
            "region"
          ]
        },
        {
          "name": "idx_customers_status",
          "columns": [
