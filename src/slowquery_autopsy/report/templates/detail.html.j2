<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ query.query_id }} · 慢查解剖台</title>
<style>{{ css|safe }}</style>
</head>
<body>
<header>
  <p class="eyebrow">
    <a href="index.html">← 批次索引</a>
    {% if query.cluster_id %} · <a href="cluster-{{ query.cluster_id }}.html">簇 {{ query.cluster_id }}</a>{% endif %}
  </p>
  <h1>单体慢查 <code>{{ query.query_id }}</code></h1>
  <p class="muted">{{ query.source_file }}:{{ query.line_no }} · {{ query.timestamp }} · {{ query.log_format }}</p>
</header>
<main>
  <section>
    <h2>执行信息</h2>
    <table>
      <tbody>
        <tr><th>耗时</th><td>{{ "%.3f"|format(query.duration_ms) }} ms</td><th>锁等待</th><td>{{ "%.3f"|format(query.lock_time_ms) }} ms</td></tr>
        <tr><th>扫描行</th><td>{{ query.rows_examined }}</td><th>返回行</th><td>{{ query.rows_sent }}</td></tr>
        <tr><th>用户</th><td>{{ query.user }}</td><th>客户端</th><td>{{ query.client }}</td></tr>
        <tr><th>数据库</th><td>{{ query.database }}</td><th>指纹</th><td><code>{{ query.fingerprint }}</code></td></tr>
        <tr><th>排除</th><td>{{ "是" if query.excluded else "否" }}</td><th>排除原因</th><td>{{ query.exclusion_reason or "—" }}</td></tr>
      </tbody>
    </table>
  </section>
  <section>
    <h2>SQL</h2>
    <pre>{{ query.sql }}</pre>
    <h3>归一化</h3>
    <pre>{{ query.normalized_sql }}</pre>
  </section>
  <section>
    <h2>成本向量</h2>
    <table>
      <thead><tr><th>指标</th><th>值</th></tr></thead>
      <tbody>
      {% for key, value in query.cost.items() %}
        <tr><td>{{ key }}</td><td>{{ value }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  <section>
    <h2>关联发现</h2>
    <table>
      <thead><tr><th>级别</th><th>规则</th><th>说明</th></tr></thead>
      <tbody>
      {% for finding in findings %}
        <tr><td><span class="sev sev-{{ finding.severity }}">{{ finding.severity }}</span></td><td><code>{{ finding.rule_id }}</code></td><td>{{ finding.description }}</td></tr>
      {% else %}
        <tr><td colspan="3">无关联发现。</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  <section>
    <h2>关联计划</h2>
    {% for plan in plans %}
      <h3>{{ plan.source_file }} <span class="muted">({{ plan.plan_format }})</span></h3>
      <table>
        <thead><tr><th>路径</th><th>操作</th><th>表</th><th>访问</th><th>行数</th><th>索引</th><th>条件</th></tr></thead>
        <tbody>
        {% for node in plan.nodes %}
          <tr><td><code>{{ node.path }}</code></td><td>{{ node.operation }}</td><td>{{ node.table_name }}</td><td>{{ node.access_type }}</td><td>{{ node.rows }}</td><td>{{ node.key_name }}</td><td><code>{{ node.condition }}</code></td></tr>
        {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="muted">未关联执行计划。</p>
    {% endfor %}
  </section>
</main>
<footer>仅静态分析本地导出文件 · 不连接数据库 · 不执行 SQL · 不发起网络请求</footer>
</body>
</html>
